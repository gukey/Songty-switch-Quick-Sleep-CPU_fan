<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon>Assets\imageres_1405.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\imageres_1405.ico" />
    <EmbeddedResource Include="$(BundledComponentsArchive)" LogicalName="DisplaySwitcher.Components.zip"
                      Condition="'$(BundledComponentsArchive)' != ''" />
  </ItemGroup>
</Project>
